<UserControl x:Class="BaseLunar.App.Vistas.EscenaNivel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BaseLunar.App.Controles"
             IsHitTestVisible="False">
    <!--
        Escena del nivel (arte provisional de F3.2; F3.3 trae el arte final y las animaciones de cada consecuencia).
        Lienzo de 1600×900 que llena el espacio recortando los bordes: lo importante está en la franja central
        (x 380–1220, y 340–570), que se ve en cualquier tamaño de ventana.
    -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{StaticResource Pincel.CieloNormal}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Alerta}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Pincel.CieloAlerta}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Viewbox Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="1600" Height="900">
                <Rectangle Width="1600" Height="900" Fill="{StaticResource Pincel.Estrellas}" />

                <!-- La Tierra, a lo lejos -->
                <Ellipse Canvas.Left="1250" Canvas.Top="150" Width="130" Height="130" Fill="{StaticResource Pincel.Tierra}" />
                <Path Fill="#B34ADE80" Data="M1275,190 C1290,175 1315,180 1318,196 C1322,212 1300,222 1290,236 C1280,230 1268,210 1275,190 Z M1335,235 C1345,228 1362,232 1360,248 C1352,262 1336,258 1335,235 Z" />

                <!-- El Sol de la tormenta solar (Nivel 4) -->
                <Grid Canvas.Left="140" Canvas.Top="40" Width="340" Height="340" Visibility="{Binding Alerta, Converter={StaticResource Visible}}">
                    <Ellipse>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFDE047" Offset="0" />
                                <GradientStop Color="#99F97316" Offset="0.45" />
                                <GradientStop Color="#00F97316" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="150" Height="150" Fill="#FFFBBF24" />
                </Grid>

                <!-- Colinas lejanas y suelo lunar con cráteres -->
                <Path Fill="#FF475569" Data="M0,515 C180,470 360,500 540,478 C740,452 960,505 1160,468 C1340,438 1480,478 1600,462 L1600,640 L0,640 Z" />
                <Path Fill="{StaticResource Pincel.Suelo}" Data="M0,560 C260,532 520,576 800,556 C1080,536 1340,576 1600,550 L1600,900 L0,900 Z" />
                <Ellipse Canvas.Left="150" Canvas.Top="640" Width="240" Height="54" Fill="#80334155" />
                <Ellipse Canvas.Left="1180" Canvas.Top="690" Width="300" Height="70" Fill="#80334155" />
                <Ellipse Canvas.Left="720" Canvas.Top="770" Width="170" Height="38" Fill="#80334155" />
                <Ellipse Canvas.Left="430" Canvas.Top="600" Width="110" Height="22" Fill="#66334155" />

                <!-- La base lunar -->
                <Canvas Canvas.Left="900" Canvas.Top="370">
                    <Rectangle Canvas.Left="-118" Canvas.Top="128" Width="8" Height="62" Fill="#FF94A3B8" />
                    <Rectangle Canvas.Left="-170" Canvas.Top="70" Width="112" Height="64" RadiusX="6" RadiusY="6" Fill="#FF1D4ED8" Stroke="#FF93C5FD" StrokeThickness="3" />
                    <Path Stroke="#FF93C5FD" StrokeThickness="2" Data="M-133,70 V134 M-96,70 V134 M-170,102 H-58" />
                    <Rectangle Canvas.Left="147" Canvas.Top="-40" Width="6" Height="80" Fill="#FFCBD5E1" />
                    <Ellipse Canvas.Left="138" Canvas.Top="-62" Width="24" Height="24" Stroke="#FFF8FAFC" StrokeThickness="3"
                             c:Animaciones.Pulso="{Binding EsRespaldo}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Pincel.Exito}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsRespaldo}" Value="True">
                                        <Setter Property="Fill" Value="#FFEF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Path Data="M30,110 A120,105 0 0 1 270,110 Z" Stroke="#FF64748B" StrokeThickness="3">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFE2E8F0" Offset="0" />
                                <GradientStop Color="#FF94A3B8" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Rectangle Canvas.Top="100" Width="300" Height="90" RadiusX="40" RadiusY="40" Fill="#FFF1F5F9" Stroke="#FF94A3B8" StrokeThickness="3" />
                    <Ellipse Canvas.Left="62" Canvas.Top="128" Width="34" Height="34" Fill="#FFFDE047" Stroke="#FF64748B" StrokeThickness="3" />
                    <Ellipse Canvas.Left="133" Canvas.Top="128" Width="34" Height="34" Fill="#FFFDE047" Stroke="#FF64748B" StrokeThickness="3" />
                    <Ellipse Canvas.Left="204" Canvas.Top="128" Width="34" Height="34" Fill="#FFFDE047" Stroke="#FF64748B" StrokeThickness="3" />
                    <Rectangle Canvas.Left="282" Canvas.Top="116" Width="36" Height="70" RadiusX="8" RadiusY="8" Fill="#FF475569" Stroke="#FF334155" StrokeThickness="3" />
                </Canvas>

                <!-- Insignia del nivel, flotando junto al astronauta -->
                <Grid Canvas.Left="390" Canvas.Top="370" Width="140" Height="140"
                      Visibility="{Binding EsVictoria, Converter={StaticResource Oculto}}">
                    <Ellipse>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#9960A5FA" Offset="0.45" />
                                <GradientStop Color="#0060A5FA" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Margin="22" Stroke="#CCFFFFFF" StrokeThickness="4">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6366F1" Offset="0" />
                                <GradientStop Color="#FF3B82F6" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <c:Icono Width="54" Height="54" Geometria="{Binding AvatarEscena, Converter={StaticResource IconoDeEmoji}}" Foreground="White" />
                </Grid>

                <!-- Victoria: el módulo del relevo, ya en la Luna -->
                <Canvas Canvas.Left="360" Canvas.Top="360" Visibility="{Binding EsVictoria, Converter={StaticResource Visible}}">
                    <Path Stroke="#FF94A3B8" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M34,150 L6,196 M146,150 L174,196" />
                    <Path Fill="#FFF1F5F9" Stroke="#FF94A3B8" StrokeThickness="4" Data="M22,160 L42,64 Q90,0 138,64 L158,160 Z" />
                    <Ellipse Canvas.Left="66" Canvas.Top="70" Width="48" Height="48" Fill="#FF60A5FA" Stroke="#FF334155" StrokeThickness="4" />
                    <Rectangle Canvas.Left="18" Canvas.Top="150" Width="144" Height="18" RadiusX="8" RadiusY="8" Fill="{StaticResource Pincel.Acento}" />
                </Canvas>

                <!-- El astronauta (F3.3 lo anima según cada consecuencia) -->
                <Canvas Canvas.Left="600" Canvas.Top="345" Width="120" Height="212" c:Animaciones.Salto="{Binding Celebracion}">
                    <Rectangle Canvas.Left="6" Canvas.Top="66" Width="108" Height="94" RadiusX="20" RadiusY="20" Fill="#FFCBD5E1" Stroke="#FF94A3B8" StrokeThickness="3" />
                    <Rectangle Canvas.Left="28" Canvas.Top="146" Width="28" Height="52" RadiusX="12" RadiusY="12" Fill="#FFF1F5F9" Stroke="#FFCBD5E1" StrokeThickness="2" />
                    <Rectangle Canvas.Left="64" Canvas.Top="146" Width="28" Height="52" RadiusX="12" RadiusY="12" Fill="#FFF1F5F9" Stroke="#FFCBD5E1" StrokeThickness="2" />
                    <Rectangle Canvas.Left="22" Canvas.Top="188" Width="38" Height="22" RadiusX="10" RadiusY="10" Fill="#FF475569" />
                    <Rectangle Canvas.Left="60" Canvas.Top="188" Width="38" Height="22" RadiusX="10" RadiusY="10" Fill="#FF475569" />
                    <Rectangle Canvas.Left="-2" Canvas.Top="80" Width="26" Height="64" RadiusX="13" RadiusY="13" Fill="#FFF1F5F9" Stroke="#FFCBD5E1" StrokeThickness="2" />
                    <Rectangle Canvas.Left="96" Canvas.Top="80" Width="26" Height="64" RadiusX="13" RadiusY="13" Fill="#FFF1F5F9" Stroke="#FFCBD5E1" StrokeThickness="2" />
                    <Rectangle Canvas.Left="18" Canvas.Top="72" Width="84" Height="86" RadiusX="26" RadiusY="26" Fill="#FFF8FAFC" Stroke="#FFCBD5E1" StrokeThickness="3" />
                    <Rectangle Canvas.Left="38" Canvas.Top="98" Width="44" Height="28" RadiusX="6" RadiusY="6" Fill="#FF1E293B" />
                    <Ellipse Canvas.Left="44" Canvas.Top="108" Width="9" Height="9" Fill="#FF60A5FA" />
                    <Ellipse Canvas.Left="56" Canvas.Top="108" Width="9" Height="9" Fill="#FFF97316" />
                    <Ellipse Canvas.Left="68" Canvas.Top="108" Width="9" Height="9" Fill="#FF4ADE80" />
                    <Ellipse Canvas.Left="14" Canvas.Top="0" Width="92" Height="84" Fill="#FFF8FAFC" Stroke="#FFCBD5E1" StrokeThickness="3" />
                    <Ellipse Canvas.Left="26" Canvas.Top="16" Width="68" Height="48" Stroke="#FF334155" StrokeThickness="3">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF1E3A8A" Offset="0" />
                                <GradientStop Color="#FF7C3AED" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="36" Canvas.Top="22" Width="22" Height="12" Fill="#99FFFFFF" />
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
