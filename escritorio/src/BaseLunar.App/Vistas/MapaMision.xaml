<UserControl x:Class="BaseLunar.App.Vistas.MapaMision"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BaseLunar.App.Controles"
             xmlns:vm="clr-namespace:BaseLunar.App.VistaModelos">
    <UserControl.Resources>
        <!-- En la disposición compacta el mapa es una franja: sin título ni rótulos, las estaciones se ven grandes -->
        <Style x:Key="EtiquetaMapa" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="c:Disposicion.Compacta" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Mapa de la misión: el camino de la base al relevo, con las 5 estaciones (una por nivel) -->
    <Grid Background="{StaticResource Pincel.CieloNormal}">
        <Rectangle Fill="{StaticResource Pincel.Estrellas}" />
        <Viewbox Stretch="Uniform" Margin="16,10">
            <Grid Width="1300">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static vm:TextosApp+Mapa.Nombre}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"
                           AutomationProperties.HeadingLevel="Level2" Style="{StaticResource EtiquetaMapa}" />
                <Grid x:Name="Camino" Grid.Row="1" HorizontalAlignment="Center">
                    <!-- El camino pasa por el centro de los círculos (fila de la ficha: 50; círculo: 120) -->
                    <Rectangle Height="10" VerticalAlignment="Top" Margin="90,105,90,0" RadiusX="5" RadiusY="5" Fill="{StaticResource Pincel.BordeControl}" />
                    <StackPanel Orientation="Horizontal">
                        <!-- Salida: la base -->
                        <Grid Width="180">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1" Width="120" Height="120" CornerRadius="60" BorderThickness="5"
                                    Background="{StaticResource Pincel.Superficie}" BorderBrush="{StaticResource Pincel.Primario}">
                                <Canvas Width="80" Height="60">
                                    <Path Data="M8,44 A32,30 0 0 1 72,44 Z" Fill="#FFE2E8F0" />
                                    <Rectangle Canvas.Top="40" Width="80" Height="18" RadiusX="9" RadiusY="9" Fill="#FFCBD5E1" />
                                </Canvas>
                            </Border>
                            <TextBlock Grid.Row="2" Text="{x:Static vm:TextosApp+Mapa.Base}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource EtiquetaMapa}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Estaciones}" Focusable="False" AutomationProperties.Name="{x:Static vm:TextosApp+Mapa.Nombre}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EstacionVM}">
                                    <Grid Width="180" AutomationProperties.Name="{Binding TextoAccesible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50" />
                                            <RowDefinition Height="120" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="Circulo" Grid.Row="1" Width="120" Height="120" CornerRadius="60" BorderThickness="5"
                                                Background="{StaticResource Pincel.Superficie}" BorderBrush="{StaticResource Pincel.BordeControl}"
                                                c:Animaciones.Pulso="{Binding EsActual}">
                                            <c:Icono x:Name="Simbolo" Width="60" Height="60" Opacity="0.75"
                                                     Geometria="{Binding Avatar, Converter={StaticResource IconoDeEmoji}}" Foreground="{StaticResource Pincel.TextoSuave}" />
                                        </Border>
                                        <!-- Sello de superado: la estación gana una estrella -->
                                        <Border x:Name="Sello" Grid.Row="1" Width="50" Height="50" CornerRadius="25" Margin="0,-6,6,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"
                                                Background="{StaticResource Pincel.Fondo}" BorderBrush="{StaticResource Pincel.Estrella}" BorderThickness="3">
                                            <c:Icono Width="30" Height="30" Geometria="{StaticResource Icono.Estrella}" Foreground="{StaticResource Pincel.Estrella}" Relleno="{StaticResource Pincel.Estrella}" />
                                        </Border>
                                        <c:TextoDecorativo Grid.Row="2" Text="{Binding Titulo}" FontSize="24" TextWrapping="Wrap" TextAlignment="Center"
                                                           Margin="6,8,6,0" Foreground="{StaticResource Pincel.TextoSuave}" Style="{StaticResource EtiquetaMapa}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EsHecha}" Value="True">
                                            <Setter TargetName="Circulo" Property="BorderBrush" Value="{StaticResource Pincel.Exito}" />
                                            <Setter TargetName="Simbolo" Property="Foreground" Value="{StaticResource Pincel.Texto}" />
                                            <Setter TargetName="Simbolo" Property="Opacity" Value="1" />
                                            <Setter TargetName="Sello" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EsActual}" Value="True">
                                            <Setter TargetName="Circulo" Property="Background" Value="{StaticResource Pincel.Acento}" />
                                            <Setter TargetName="Circulo" Property="BorderBrush" Value="{StaticResource Pincel.Texto}" />
                                            <Setter TargetName="Simbolo" Property="Foreground" Value="{StaticResource Pincel.TextoOscuro}" />
                                            <Setter TargetName="Simbolo" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Meta: el relevo -->
                        <Grid Width="180">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1" Width="120" Height="120" CornerRadius="60" BorderThickness="5"
                                    Background="{StaticResource Pincel.Superficie}" BorderBrush="{StaticResource Pincel.Estrella}">
                                <c:Icono Width="60" Height="60" Geometria="{StaticResource Icono.Bandera}" Foreground="{StaticResource Pincel.Estrella}" />
                            </Border>
                            <TextBlock Grid.Row="2" Text="{x:Static vm:TextosApp+Mapa.Meta}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource EtiquetaMapa}" />
                        </Grid>
                    </StackPanel>

                    <!-- Ficha del astronauta: el director la lleva de casilla en casilla (180 por casilla; 0 base, 6 meta) -->
                    <Canvas x:Name="Ficha" Width="180" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform CenterX="90" CenterY="50" />
                                <RotateTransform CenterX="90" CenterY="50" />
                                <TranslateTransform />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="66" Canvas.Top="0" Width="48" Height="46" Fill="#FFF8FAFC" Stroke="#FFF97316" StrokeThickness="4" />
                        <Ellipse Canvas.Left="74" Canvas.Top="9" Width="32" Height="24" Fill="#FF4338CA" Stroke="#FF334155" StrokeThickness="2" />
                        <Ellipse Canvas.Left="79" Canvas.Top="12" Width="11" Height="7" Fill="#99FFFFFF" />
                    </Canvas>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
