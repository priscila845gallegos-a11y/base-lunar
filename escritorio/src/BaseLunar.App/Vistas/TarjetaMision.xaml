<UserControl x:Class="BaseLunar.App.Vistas.TarjetaMision"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BaseLunar.App.Controles"
             xmlns:vm="clr-namespace:BaseLunar.App.VistaModelos">
    <UserControl.Resources>
        <!-- Viñeta de las instrucciones -->
        <DataTemplate x:Key="Instruccion">
            <DockPanel Margin="0,8,0,0">
                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Pincel.Acento}" Margin="2,9,12,0" VerticalAlignment="Top" />
                <TextBlock Style="{StaticResource Texto.Normal}" c:Contenido.Texto="{Binding}" />
            </DockPanel>
        </DataTemplate>

        <!-- Línea con ícono (los medidores del certificado) -->
        <DataTemplate x:Key="LineaConIcono">
            <TextBlock Style="{StaticResource Texto.Normal}" Margin="0,4,0,0" c:Contenido.Texto="{Binding}" />
        </DataTemplate>

        <!-- Un dato aprendido en el certificado: título, texto y fuentes -->
        <DataTemplate x:Key="DatoAprendido" DataType="{x:Type vm:DatoVM}">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Texto.Normal}" FontWeight="Bold" Text="{Binding Titulo}" />
                <TextBlock Style="{StaticResource Texto.Normal}" Text="{Binding Texto}" />
                <TextBlock Style="{StaticResource Texto.Nota}" Margin="0,2,0,0" c:Contenido.Fuentes="{Binding}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="Marco" CornerRadius="22" BorderThickness="2" Background="{DynamicResource Pincel.SuperficieTranslucida}"
            c:Animaciones.Temblor="{Binding Temblor}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Pincel.Borde}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Alerta}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Pincel.Acento}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <ScrollViewer x:Name="Desplazamiento" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="True" IsTabStop="True" FocusVisualStyle="{StaticResource Foco}" Padding="22,16,16,18"
                      AutomationProperties.Name="{x:Static vm:TextosApp.RegionTarjeta}" AutomationProperties.AutomationId="Tarjeta">
            <Grid>
                <!-- ========== Inicio ========== -->
                <StackPanel x:Name="VistaInicio" Visibility="{Binding EsInicio, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Pildora}">
                            <TextBlock Style="{StaticResource Texto.Etiqueta}" c:Contenido.Texto="{x:Static vm:TextosApp+Inicio.Etiqueta}" />
                        </Border>
                        <DockPanel Style="{StaticResource CabeceraTitulo}">
                            <Border Style="{StaticResource Insignia}">
                                <c:Icono Margin="13" Geometria="{StaticResource Icono.Luna}" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="TituloInicio" Style="{StaticResource Texto.Titulo}" Text="{x:Static vm:TextosApp+Inicio.Titulo}"
                                       AutomationProperties.AutomationId="TituloInicio" />
                        </DockPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Texto.Historia}" Text="{x:Static vm:TextosApp+Inicio.Historia}" />
                    <ItemsControl Margin="0,6,0,0" Focusable="False" ItemsSource="{x:Static vm:TextosApp+Inicio.Instrucciones}"
                                  ItemTemplate="{StaticResource Instruccion}" />
                    <TextBlock Style="{StaticResource Texto.Nota}" Text="{x:Static vm:TextosApp+Inicio.Nota}" />
                </StackPanel>

                <!-- ========== Nivel: decisión, resultado y respaldo ========== -->
                <StackPanel x:Name="VistaNivel" Visibility="{Binding EsVistaNivel, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Pildora}">
                            <TextBlock Style="{StaticResource Texto.Etiqueta}" c:Contenido.Texto="{Binding Etiqueta}"
                                       AutomationProperties.AutomationId="EtiquetaNivel" />
                        </Border>
                        <DockPanel Style="{StaticResource CabeceraTitulo}">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Insignia}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Alerta}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Pincel.Acento}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <c:Icono Margin="13" Geometria="{Binding Avatar, Converter={StaticResource IconoDeEmoji}}" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="TituloNivel" Style="{StaticResource Texto.Titulo}" Text="{Binding TituloNivel}"
                                       AutomationProperties.Name="{Binding NombreTituloNivel}" AutomationProperties.AutomationId="TituloNivel" />
                        </DockPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Texto.Historia}" Text="{Binding Historia}" AutomationProperties.AutomationId="Historia" />

                    <!-- Glosario: palabras difíciles del nivel, cada una con su explicación y su fuente -->
                    <ItemsControl Margin="0,12,0,0" Focusable="False" ItemsSource="{Binding Terminos}"
                                  Visibility="{Binding Terminos, Converter={StaticResource Visible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Termino}">
                                <Button Style="{StaticResource BotonGlosario}" Content="{Binding Palabra}"
                                        Command="{Binding DataContext.VerTermino, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Pregunta}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="CajaDefinicion" Style="{StaticResource Aviso}" Margin="0,4,0,0" BorderBrush="{DynamicResource Pincel.Enlace}"
                            Visibility="{Binding Definicion, Converter={StaticResource Visible}}" IsVisibleChanged="AlMostrarDefinicion">
                        <StackPanel DataContext="{Binding Definicion}">
                            <TextBlock Style="{StaticResource Texto.Normal}" AutomationProperties.AutomationId="Definicion">
                                <Run FontWeight="Bold" Text="{Binding Titulo, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Texto, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Texto.Nota}" Margin="0,6,0,0" c:Contenido.Fuentes="{Binding}" />
                        </StackPanel>
                    </Border>

                    <!-- Aviso de llamarada de clase X -->
                    <Border Style="{StaticResource Aviso}" BorderBrush="{DynamicResource Pincel.Acento}"
                            Visibility="{Binding AvisoX, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <c:Icono Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Top" Geometria="{StaticResource Icono.Sol}" Foreground="{DynamicResource Pincel.Acento}" />
                            <TextBlock Style="{StaticResource Texto.Normal}" Text="{Binding AvisoX}" AutomationProperties.AutomationId="AvisoX" />
                        </DockPanel>
                    </Border>

                    <!-- Ayuda de Control de Misión (antibloqueo) -->
                    <Border Style="{StaticResource Aviso}" BorderBrush="{DynamicResource Pincel.Primario}"
                            Visibility="{Binding AvisoAyuda, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <c:Icono Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Top" Geometria="{StaticResource Icono.Antena}" Foreground="{DynamicResource Pincel.Enlace}" />
                            <TextBlock Style="{StaticResource Texto.Normal}" Text="{Binding AvisoAyuda}" AutomationProperties.AutomationId="AvisoAyuda" />
                        </DockPanel>
                    </Border>

                    <!-- Protocolo de Respaldo -->
                    <Border x:Name="AvisoRespaldo" Style="{StaticResource Aviso}" BorderBrush="{DynamicResource Pincel.Acento}"
                            Visibility="{Binding EsRespaldo, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <c:Icono Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" Geometria="{StaticResource Icono.Salvavidas}" Foreground="{DynamicResource Pincel.Acento}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Texto.Normal}" FontWeight="Bold" Text="{Binding MensajeRespaldo}"
                                           AutomationProperties.AutomationId="MensajeRespaldo" />
                                <TextBlock Style="{StaticResource Texto.Normal}" Margin="0,8,0,0" Foreground="{DynamicResource Pincel.TextoSuave}" Text="{Binding PistaRespaldo}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Resultado y 💡 Dato real -->
                    <StackPanel x:Name="Resultado" Margin="0,14,0,0" Visibility="{Binding EsResultado, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Texto.Normal}" FontSize="20" FontWeight="Bold" Text="{Binding TextoResultado}"
                                   AutomationProperties.AutomationId="TextoResultado" />
                        <Border Margin="0,12,0,0" Padding="16,12" CornerRadius="14" Background="{DynamicResource Pincel.Fondo}"
                                BorderBrush="{DynamicResource Pincel.Primario}" BorderThickness="5,0,0,0">
                            <StackPanel DataContext="{Binding Dato}">
                                <TextBlock Style="{StaticResource Texto.Seccion}" Foreground="{DynamicResource Pincel.Estrella}"
                                           c:Contenido.Texto="{x:Static vm:TextosApp.DatoReal}" />
                                <TextBlock Style="{StaticResource Texto.Normal}" Margin="0,6,0,0" Text="{Binding Texto}"
                                           AutomationProperties.AutomationId="TextoDato" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding Extra}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Texto.Normal}" Margin="0,6,0,0" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Mini escala de llamaradas (Nivel 4): la clase de la llamarada, resaltada -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Visibility="{Binding EscalaLlamarada, Converter={StaticResource Visible}}">
                                    <ItemsControl Focusable="False" ItemsSource="{Binding EscalaLlamarada}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LetraEscala}">
                                                <Border x:Name="Casilla" Width="34" Height="34" CornerRadius="8" Margin="0,0,6,0"
                                                        Background="{DynamicResource Pincel.Superficie}" BorderBrush="{DynamicResource Pincel.BordeControl}" BorderThickness="2">
                                                    <c:TextoDecorativo x:Name="Letra" Text="{Binding Letra}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Pincel.TextoSuave}" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Activa}" Value="True">
                                                        <Setter TargetName="Casilla" Property="Background" Value="{DynamicResource Pincel.Acento}" />
                                                        <Setter TargetName="Casilla" Property="BorderBrush" Value="{DynamicResource Pincel.Texto}" />
                                                        <Setter TargetName="Letra" Property="Foreground" Value="{DynamicResource Pincel.TextoOscuro}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Texto.Nota}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Text="{x:Static vm:TextosApp+Donki.Escala}" AutomationProperties.Name="{Binding EscalaAccesible}"
                                               AutomationProperties.AutomationId="EscalaLlamarada" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Texto.Nota}" Margin="0,8,0,0" c:Contenido.Fuentes="{Binding}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ========== Misión Abortada ========== -->
                <StackPanel x:Name="VistaAbortada" Visibility="{Binding EsAbortada, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Pildora}">
                            <TextBlock Style="{StaticResource Texto.Etiqueta}" c:Contenido.Texto="{x:Static vm:TextosApp+Abortada.Etiqueta}" />
                        </Border>
                        <DockPanel Style="{StaticResource CabeceraTitulo}">
                            <Border Style="{StaticResource Insignia}" Background="{DynamicResource Pincel.Tierra}" />
                            <TextBlock x:Name="TituloAbortada" Style="{StaticResource Texto.Titulo}" Text="{x:Static vm:TextosApp+Abortada.Titulo}"
                                       AutomationProperties.AutomationId="TituloAbortada" />
                        </DockPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Texto.Historia}" Text="{x:Static vm:TextosApp+Abortada.Historia}" />
                </StackPanel>

                <!-- ========== Victoria: certificado ========== -->
                <StackPanel x:Name="VistaVictoria" Visibility="{Binding EsVictoria, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Pildora}">
                            <TextBlock Style="{StaticResource Texto.Etiqueta}" c:Contenido.Texto="{x:Static vm:TextosApp+Victoria.Etiqueta}" />
                        </Border>
                        <DockPanel Style="{StaticResource CabeceraTitulo}">
                            <Border Style="{StaticResource Insignia}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FDE047" Offset="0" />
                                        <GradientStop Color="#F97316" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <c:Icono Margin="13" Geometria="{StaticResource Icono.Estrella}" Foreground="{DynamicResource Pincel.TextoOscuro}" />
                            </Border>
                            <TextBlock x:Name="TituloVictoria" Style="{StaticResource Texto.Titulo}" Text="{x:Static vm:TextosApp+Victoria.Titulo}"
                                       AutomationProperties.AutomationId="TituloVictoria" />
                        </DockPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Texto.Historia}" Text="{x:Static vm:TextosApp+Victoria.Historia}" />
                    <!-- Nombre opcional (D-17): solo en memoria; nunca se guarda, se envía ni se lee en voz alta -->
                    <TextBlock x:Name="EtiquetaNombre" Style="{StaticResource Texto.Normal}" FontWeight="Bold" Margin="0,14,0,0"
                               Text="{x:Static vm:TextosApp+Victoria.NombreEtiqueta}" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBox x:Name="CampoNombre" Style="{StaticResource CampoTexto}" Width="300" Margin="0,0,12,8"
                                 MaxLength="24" Text="{Binding NombreCertificado, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{x:Static vm:TextosApp+Victoria.NombreEtiqueta}"
                                 AutomationProperties.AutomationId="NombreCertificado" />
                        <Button x:Name="BotonImprimir" Style="{StaticResource BotonBarra}" Margin="0,0,0,8" Command="{Binding Imprimir}"
                                AutomationProperties.Name="{x:Static vm:TextosApp+Victoria.Imprimir}" AutomationProperties.AutomationId="BotonImprimir">
                            <StackPanel Orientation="Horizontal">
                                <c:Icono Width="22" Height="22" Geometria="{StaticResource Icono.Imprimir}" />
                                <c:TextoDecorativo Text="{x:Static vm:TextosApp+Victoria.Imprimir}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Texto.Seccion}" Foreground="{DynamicResource Pincel.Estrella}" Text="{Binding LineaNombre}"
                               Visibility="{Binding LineaNombre, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="LineaNombre" />
                    <TextBlock Style="{StaticResource Texto.Normal}" Margin="0,8,0,0" Text="{Binding FechaCertificado}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ItemsControl Focusable="False" ItemsSource="{Binding Estrellas}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:Icono Width="28" Height="28" Margin="0,0,4,0" Geometria="{StaticResource Icono.Estrella}"
                                             Foreground="{DynamicResource Pincel.Estrella}" Relleno="{DynamicResource Pincel.Estrella}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Texto.Normal}" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding TextoRespaldosCertificado}"
                                   AutomationProperties.AutomationId="RespaldosCertificado" />
                    </StackPanel>
                    <ItemsControl Margin="0,6,0,0" Focusable="False" ItemsSource="{Binding MedidoresCertificado}" ItemTemplate="{StaticResource LineaConIcono}" />
                    <TextBlock Style="{StaticResource Texto.Seccion}" Margin="0,18,0,0" Text="{x:Static vm:TextosApp+Victoria.Aprendiste}" />
                    <ItemsControl Focusable="False" ItemsSource="{Binding DatosCertificado}" ItemTemplate="{StaticResource DatoAprendido}" />
                    <TextBlock Style="{StaticResource Texto.Nota}" Text="{x:Static vm:TextosApp+Victoria.Nota}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
