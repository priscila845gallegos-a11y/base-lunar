<UserControl x:Class="BaseLunar.App.Vistas.PantallaJuego"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BaseLunar.App.Controles"
             xmlns:v="clr-namespace:BaseLunar.App.Vistas"
             xmlns:vm="clr-namespace:BaseLunar.App.VistaModelos"
             FontFamily="{StaticResource Fuente.Principal}" FontSize="{StaticResource Tamano.Base}"
             Foreground="{DynamicResource Pincel.Texto}" UseLayoutRounding="True">
    <!--
        Pantalla del juego. Dos disposiciones (PantallaJuego.xaml.cs):
        · Ancha (1000 DIP o más): barra superior; la escena a la izquierda y, a la derecha, medidores, tarjeta y decisiones.
        · Compacta: barra superior, medidores en fila, escena en franja, tarjeta y decisiones lado a lado.
    -->
    <Grid x:Name="Raiz">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{DynamicResource Pincel.Espacio}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Alerta}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Pincel.CieloAlerta}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Rectangle Fill="{DynamicResource Pincel.Estrellas}" Opacity="0.5" IsHitTestVisible="False" />

        <Grid x:Name="Rejilla" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ColumnaLateral" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="FilaEscena" Height="3*" MinHeight="110" />
                <RowDefinition x:Name="FilaTarjeta" Height="5*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <v:PanelEstado x:Name="Estado" Grid.ColumnSpan="2" Margin="0,0,0,10" />
            <v:PanelMedidores x:Name="Medidores" Grid.Row="1" Margin="0,0,0,10" Panel.ZIndex="1" />
            <Border x:Name="Escena" Grid.Row="2" Margin="0,0,0,10" CornerRadius="22" c:Animaciones.Radio="22">
                <v:Escenario x:Name="Escenario" />
            </Border>
            <v:TarjetaMision x:Name="Tarjeta" Grid.Row="3" Margin="0,0,0,10" />
            <v:PanelDecisiones x:Name="Decisiones" Grid.Row="4" />
        </Grid>

        <!-- Regiones en vivo para el lector de pantalla, como aria-live en la web (5.5) -->
        <TextBlock x:Name="AnuncioCortes" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AnuncioCortes" />
        <TextBlock x:Name="AnuncioUrgente" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="AnuncioUrgente" />

        <!-- Modo de depuración (opción debug): estado interno y registro técnico, solo para quien prueba (sección 7) -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Padding="10,8" MaxWidth="600" CornerRadius="10"
                Background="#E6000000" BorderBrush="#FF4ADE80" BorderThickness="1" IsHitTestVisible="False"
                Visibility="{Binding ModoDepuracion, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock Text="{Binding TextoDepuracion}" FontFamily="Consolas" FontSize="13" Foreground="#FF4ADE80" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Depuracion" />
                <ItemsControl Focusable="False" ItemsSource="{Binding RegistroDepuracion}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#FFFDE047" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Control de Misión (D-57): un error inesperado nunca deja al niño atascado -->
        <Grid x:Name="ControlMision" Background="#D9020617" Visibility="{Binding ControlMisionVisible, Converter={StaticResource Visible}}"
              IsVisibleChanged="AlMostrarControlMision">
            <Border MaxWidth="580" Margin="24" Padding="28,24" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Pincel.Superficie}" BorderBrush="{DynamicResource Pincel.Enlace}" BorderThickness="3">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource Insignia}">
                            <c:Icono Margin="13" Geometria="{StaticResource Icono.Antena}" Foreground="White" />
                        </Border>
                        <TextBlock Style="{StaticResource Texto.Titulo}" Text="{x:Static vm:TextosApp+ControlMision.Titulo}"
                                   AutomationProperties.AutomationId="TituloControlMision" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Texto.Historia}" Text="{x:Static vm:TextosApp+ControlMision.Mensaje}" />
                    <Button x:Name="BotonSeguir" Style="{StaticResource BotonPrincipal}" Margin="0,22,0,0" Command="{Binding SeguirMision}"
                            AutomationProperties.Name="{x:Static vm:TextosApp+ControlMision.Boton}" AutomationProperties.AutomationId="BotonSeguirMision">
                        <c:TextoDecorativo Text="{x:Static vm:TextosApp+ControlMision.Boton}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
