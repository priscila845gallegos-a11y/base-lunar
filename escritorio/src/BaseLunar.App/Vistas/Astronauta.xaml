<UserControl x:Class="BaseLunar.App.Vistas.Astronauta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BaseLunar.App.Controles"
             Width="120" Height="212" IsHitTestVisible="False">
    <!--
        Astronauta articulado (vectores propios). Cada pieza gira sobre su pivote (hombros, caderas, cuello)
        con un grupo [escala, giro, traslado] que anima Animacion/Posturas.cs. Mira de frente: un brazo a
        90° apunta hacia su lado.
    -->
    <Canvas x:Name="Cuerpo" Width="120" Height="212">
        <Canvas.RenderTransform>
            <TransformGroup>
                <ScaleTransform CenterX="60" CenterY="212" />
                <RotateTransform CenterX="60" CenterY="212" />
                <TranslateTransform />
            </TransformGroup>
        </Canvas.RenderTransform>

        <!-- Mochila -->
        <Rectangle Canvas.Left="6" Canvas.Top="66" Width="108" Height="94" RadiusX="20" RadiusY="20" Fill="#FFCBD5E1" Stroke="#FF94A3B8" StrokeThickness="3" />

        <!-- Piernas con botas (pivote en la cadera) -->
        <Canvas x:Name="PiernaIzq">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform CenterX="42" CenterY="148" />
                    <RotateTransform CenterX="42" CenterY="148" />
                    <TranslateTransform />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Rectangle Canvas.Left="28" Canvas.Top="146" Width="28" Height="52" RadiusX="12" RadiusY="12" Fill="#FFF1F5F9" Stroke="#FFCBD5E1" StrokeThickness="2" />
            <Rectangle Canvas.Left="22" Canvas.Top="188" Width="38" Height="22" RadiusX="10" RadiusY="10" Fill="#FF475569" />
        </Canvas>
        <Canvas x:Name="PiernaDer">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform CenterX="78" CenterY="148" />
                    <RotateTransform CenterX="78" CenterY="148" />
                    <TranslateTransform />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Rectangle Canvas.Left="64" Canvas.Top="146" Width="28" Height="52" RadiusX="12" RadiusY="12" Fill="#FFF1F5F9" Stroke="#FFCBD5E1" StrokeThickness="2" />
            <Rectangle Canvas.Left="60" Canvas.Top="188" Width="38" Height="22" RadiusX="10" RadiusY="10" Fill="#FF475569" />
        </Canvas>

        <!-- Brazo izquierdo (a la izquierda de la imagen), con la regadera del huerto -->
        <Canvas x:Name="BrazoIzq">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform CenterX="11" CenterY="86" />
                    <RotateTransform CenterX="11" CenterY="86" />
                    <TranslateTransform />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Rectangle Canvas.Left="-2" Canvas.Top="80" Width="26" Height="64" RadiusX="13" RadiusY="13" Fill="#FFF1F5F9" Stroke="#FFCBD5E1" StrokeThickness="2" />
            <Ellipse Canvas.Left="0" Canvas.Top="132" Width="22" Height="18" Fill="#FF94A3B8" />
            <Canvas x:Name="Regadera" Opacity="0">
                <Path Fill="#FF22D3EE" Stroke="#FF0E7490" StrokeThickness="2" Data="M-6,146 L26,146 L22,170 L-2,170 Z" />
                <Path Stroke="#FF0E7490" StrokeThickness="4" StrokeEndLineCap="Round" Data="M-4,152 L-20,140" />
            </Canvas>
        </Canvas>

        <!-- Torso con el panel del pecho (respira escalando desde la cintura) -->
        <Canvas x:Name="Torso">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform CenterX="60" CenterY="158" />
                    <RotateTransform CenterX="60" CenterY="158" />
                    <TranslateTransform />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Rectangle Canvas.Left="18" Canvas.Top="72" Width="84" Height="86" RadiusX="26" RadiusY="26" Fill="#FFF8FAFC" Stroke="#FFCBD5E1" StrokeThickness="3" />
            <Rectangle Canvas.Left="38" Canvas.Top="98" Width="44" Height="28" RadiusX="6" RadiusY="6" Fill="#FF1E293B" />
            <Ellipse Canvas.Left="44" Canvas.Top="108" Width="9" Height="9" Fill="#FF60A5FA" />
            <Ellipse Canvas.Left="56" Canvas.Top="108" Width="9" Height="9" Fill="#FFF97316" />
            <Ellipse Canvas.Left="68" Canvas.Top="108" Width="9" Height="9" Fill="#FF4ADE80" />
        </Canvas>

        <!-- Brazo derecho -->
        <Canvas x:Name="BrazoDer">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform CenterX="109" CenterY="86" />
                    <RotateTransform CenterX="109" CenterY="86" />
                    <TranslateTransform />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Rectangle Canvas.Left="96" Canvas.Top="80" Width="26" Height="64" RadiusX="13" RadiusY="13" Fill="#FFF1F5F9" Stroke="#FFCBD5E1" StrokeThickness="2" />
            <Ellipse Canvas.Left="98" Canvas.Top="132" Width="22" Height="18" Fill="#FF94A3B8" />
        </Canvas>

        <!-- Casco con visor (pivote en el cuello) -->
        <Canvas x:Name="Cabeza">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform CenterX="60" CenterY="80" />
                    <RotateTransform CenterX="60" CenterY="80" />
                    <TranslateTransform />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse Canvas.Left="14" Canvas.Top="0" Width="92" Height="84" Fill="#FFF8FAFC" Stroke="#FFCBD5E1" StrokeThickness="3" />
            <Ellipse Canvas.Left="26" Canvas.Top="16" Width="68" Height="48" Stroke="#FF334155" StrokeThickness="3">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF1E3A8A" Offset="0" />
                        <GradientStop Color="#FF7C3AED" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="36" Canvas.Top="22" Width="22" Height="12" Fill="#99FFFFFF" />
            <!-- Escarcha en el visor (fallo de batería) -->
            <Path x:Name="EscarchaVisor" Opacity="0" Stroke="#FFE0F2FE" StrokeThickness="2.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                  Data="M70,24 L84,38 M84,24 L70,38 M77,22 L77,40 M66,31 L88,31" />
        </Canvas>
    </Canvas>
</UserControl>
