<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta del Prompt 0 (5.3) -->
    <Color x:Key="Color.Fondo">#0F172A</Color>
    <Color x:Key="Color.Superficie">#1E293B</Color>
    <Color x:Key="Color.Primario">#3B82F6</Color>
    <Color x:Key="Color.Acento">#F97316</Color>
    <Color x:Key="Color.Alerta">#450A0A</Color>

    <!-- Neutros (contrastes en DECISIONES.md, D-20) -->
    <Color x:Key="Color.Texto">#F8FAFC</Color>
    <Color x:Key="Color.TextoSuave">#CBD5E1</Color>
    <Color x:Key="Color.TextoOscuro">#0F172A</Color>
    <Color x:Key="Color.Enlace">#93C5FD</Color>
    <Color x:Key="Color.Borde">#334155</Color>
    <Color x:Key="Color.BordeControl">#64748B</Color>

    <!-- Colores de juego (D-38): uno por medidor y los de recompensa -->
    <Color x:Key="Color.Proteccion">#A78BFA</Color>
    <Color x:Key="Color.Soporte">#22D3EE</Color>
    <Color x:Key="Color.Bateria">#FACC15</Color>
    <Color x:Key="Color.Estrella">#FDE047</Color>
    <Color x:Key="Color.Exito">#4ADE80</Color>

    <SolidColorBrush x:Key="Pincel.Fondo" Color="{StaticResource Color.Fondo}" />
    <SolidColorBrush x:Key="Pincel.Superficie" Color="{StaticResource Color.Superficie}" />
    <SolidColorBrush x:Key="Pincel.SuperficieTranslucida" Color="#EB1E293B" />
    <SolidColorBrush x:Key="Pincel.Primario" Color="{StaticResource Color.Primario}" />
    <SolidColorBrush x:Key="Pincel.Acento" Color="{StaticResource Color.Acento}" />
    <SolidColorBrush x:Key="Pincel.Alerta" Color="{StaticResource Color.Alerta}" />
    <SolidColorBrush x:Key="Pincel.Texto" Color="{StaticResource Color.Texto}" />
    <SolidColorBrush x:Key="Pincel.TextoSuave" Color="{StaticResource Color.TextoSuave}" />
    <SolidColorBrush x:Key="Pincel.TextoOscuro" Color="{StaticResource Color.TextoOscuro}" />
    <SolidColorBrush x:Key="Pincel.Enlace" Color="{StaticResource Color.Enlace}" />
    <SolidColorBrush x:Key="Pincel.Borde" Color="{StaticResource Color.Borde}" />
    <SolidColorBrush x:Key="Pincel.BordeControl" Color="{StaticResource Color.BordeControl}" />
    <SolidColorBrush x:Key="Pincel.Proteccion" Color="{StaticResource Color.Proteccion}" />
    <SolidColorBrush x:Key="Pincel.Soporte" Color="{StaticResource Color.Soporte}" />
    <SolidColorBrush x:Key="Pincel.Bateria" Color="{StaticResource Color.Bateria}" />
    <SolidColorBrush x:Key="Pincel.Estrella" Color="{StaticResource Color.Estrella}" />
    <SolidColorBrush x:Key="Pincel.Exito" Color="{StaticResource Color.Exito}" />
    <SolidColorBrush x:Key="Pincel.Velo" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Pincel.Costo" Color="#FCA5A5" />
    <SolidColorBrush x:Key="Pincel.FondoEfecto" Color="#F20F172A" />
    <SolidColorBrush x:Key="Pincel.Pista" Color="#FF0B1222" />
    <SolidColorBrush x:Key="Pincel.BordeBoton" Color="#4DFFFFFF" />

    <!-- Fondo del espacio -->
    <LinearGradientBrush x:Key="Pincel.Espacio" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#070B1F" Offset="0" />
        <GradientStop Color="#151338" Offset="0.6" />
        <GradientStop Color="#231A4D" Offset="1" />
    </LinearGradientBrush>

    <!-- Estrellas: mosaico de puntos que se repite -->
    <DrawingBrush x:Key="Pincel.Estrellas" TileMode="Tile" Stretch="None"
                  Viewport="0,0,220,220" ViewportUnits="Absolute" Viewbox="0,0,220,220" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,220,220" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E6F8FAFC">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="18,26" RadiusX="1.4" RadiusY="1.4" />
                            <EllipseGeometry Center="96,14" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="172,48" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="60,96" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="140,120" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="206,150" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="30,170" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="110,196" RadiusX="1.5" RadiusY="1.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Cielo de las escenas: normal y tormenta solar (Nivel 4) -->
    <LinearGradientBrush x:Key="Pincel.CieloNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B1026" Offset="0" />
        <GradientStop Color="#2E1F6B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Pincel.CieloAlerta" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#450A0A" Offset="0" />
        <GradientStop Color="#9A3412" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Pincel.Suelo" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#94A3B8" Offset="0" />
        <GradientStop Color="#475569" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Pincel.Tierra" GradientOrigin="0.35,0.3">
        <GradientStop Color="#60A5FA" Offset="0" />
        <GradientStop Color="#1D4ED8" Offset="0.7" />
        <GradientStop Color="#1E3A8A" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
