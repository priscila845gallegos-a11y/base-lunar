<Window x:Class="BaseLunar.App.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BaseLunar.App.Vistas"
        xmlns:vm="clr-namespace:BaseLunar.App.VistaModelos"
        Title="{x:Static vm:TextosApp.TituloVentana}"
        Width="1280" Height="800" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Pincel.Fondo}"
        AutomationProperties.AutomationId="VentanaBaseLunar"
        KeyDown="AlPulsarTecla" Loaded="AlCargar">
    <v:PantallaJuego x:Name="Pantalla" />
</Window>
