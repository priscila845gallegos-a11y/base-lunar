<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>BaseLunar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Base Lunar: El Escudo Cósmico</Product>
    <AssemblyTitle>Base Lunar: El Escudo Cósmico</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaseLunar.Nucleo\BaseLunar.Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Atkinson Hyperlegible (Braille Institute, licencia SIL OFL): la licencia viaja con el programa. -->
    <Resource Include="Temas\Fuentes\*.ttf" />
    <None Include="Temas\Fuentes\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Íconos de Lucide (licencia ISC, y MIT para los derivados de Feather): su licencia también viaja con el programa. -->
    <None Include="Temas\Lucide-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Voz local de Windows (SAPI): paquete oficial de Microsoft, sin conexión (D-50) -->
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

</Project>
